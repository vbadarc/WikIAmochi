{
  "name": "wikiamochi",
  "productName": "WikIAmochi",
  "version": "1.0.0",
  "description": "WikIAmochi - Enciclopedia Tamagotchi Autónoma Infantil para Windows y Android",
  "main": "resources/app/main.js",
  "scripts": {
    "start": "electron resources/app",
    "build:web": "node scripts/build-web.mjs",
